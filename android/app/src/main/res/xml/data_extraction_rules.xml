<?xml version="1.0" encoding="utf-8"?>
<!--
  ADR-010: intentions and session history never leave the device through Android backup or
  device-to-device transfer. android:allowBackup="false" covers pre-12 devices; these rules
  cover API 31+, where D2D transfer is not governed by allowBackup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
